# SUPABASE CREDENTIALS
# Get these from: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# GEMINI AI CREDENTIALS
# Get your API key from: https://aistudio.google.com/app/apikey
# Model: gemini-2.5-flash
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# CLOUDFLARE CREDENTIALS
# Para subir fotos y videos
# =============================================================================

# Account ID: Dashboard > Workers & Pages > Overview (sidebar derecho)
EXPO_PUBLIC_CLOUDFLARE_ACCOUNT_ID=your-account-id

# R2 Storage - para fotos y videos cortos
# Crear API Token: R2 > Manage R2 API Tokens > Create API Token
EXPO_PUBLIC_CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
EXPO_PUBLIC_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
EXPO_PUBLIC_CLOUDFLARE_R2_BUCKET_NAME=trens-exercise-media
EXPO_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://media.trens.app

# Cloudflare Stream - para videos largos con transcoding
# Crear Token: Stream > Use API (necesita permisos Stream:Edit)
EXPO_PUBLIC_CLOUDFLARE_STREAM_TOKEN=your-stream-api-token
EXPO_PUBLIC_CLOUDFLARE_STREAM_SUBDOMAIN=videodelivery.net
