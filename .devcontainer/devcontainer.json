{
  "name": "TRENS Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // =====================================================
        // 🤖 AI & Copilot - Asistencia IA
        // =====================================================
        "GitHub.copilot",
        "GitHub.copilot-chat",

        // =====================================================
        // 📝 Code Quality - Calidad de código
        // =====================================================
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",

        // =====================================================
        // 🎨 Frontend - React Native & Tailwind
        // =====================================================
        "bradlc.vscode-tailwindcss",
        "expo.vscode-expo-tools",
        "formulahendry.auto-rename-tag",
        "dsznajder.es7-react-js-snippets",
        "unifiedjs.vscode-mdx",

        // =====================================================
        // 🗄️ Database - Supabase & SQL
        // =====================================================
        "cweijan.vscode-database-client2",
        "supabase.vscode-supabase-extension",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",

        // =====================================================
        // 🌐 API Testing - HTTP Client
        // =====================================================
        "humao.rest-client",

        // =====================================================
        // 🎬 Media & Design
        // =====================================================
        "yopenspace.media-preview",

        // =====================================================
        // 🔧 Utilities - Herramientas generales
        // =====================================================
        "mikestead.dotenv",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "gruntfuggly.todo-tree",
        "wayou.vscode-todo-highlight",
        "pkief.material-icon-theme",
        "aaron-bond.better-comments",
        "oderwat.indent-rainbow",
        "vitest.explorer",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.preferences.importModuleSpecifier": "relative",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.minimap.enabled": false,
        "workbench.iconTheme": "material-icon-theme",
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "git.autofetch": true
      }
    }
  },

  "forwardPorts": [8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": { "label": "Metro Bundler", "onAutoForward": "notify" },
    "19000": { "label": "Expo", "onAutoForward": "notify" },
    "19001": { "label": "Expo DevTools", "onAutoForward": "silent" },
    "19002": { "label": "Expo Web", "onAutoForward": "silent" }
  },

  "postCreateCommand": "npm install && echo '✅ TRENS ready'",

  "postStartCommand": "bash -c 'cat >> ~/.bashrc << \"EOF\"\n# TRENS Autonomous Mode\nexport CI=true\nexport DEBIAN_FRONTEND=noninteractive\nexport npm_config_yes=true\nexport GIT_TERMINAL_PROMPT=0\nexport EXPO_NO_PROMPT=1\nexport FORCE_COLOR=1\nEOF\n'",

  "remoteEnv": {
    "CI": "true",
    "DEBIAN_FRONTEND": "noninteractive",
    "npm_config_yes": "true",
    "GIT_TERMINAL_PROMPT": "0",
    "EXPO_NO_PROMPT": "1",
    "FORCE_COLOR": "1"
  },

  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
