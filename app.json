{
  "expo": {
    "name": "TRENS",
    "slug": "trens",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trens.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:share.trens.app", "applinks:trens.app"],
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["spotify", "instagram"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["trensdev"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 1,
      "package": "com.trens.app",
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "share.trens.app",
              "pathPrefix": "/v"
            },
            {
              "scheme": "https",
              "host": "trens.app",
              "pathPrefix": "/share"
            },
            {
              "scheme": "trensdev",
              "host": "spotify-callback"
            },
            {
              "scheme": "trensdev",
              "host": "instagram-callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "TRENS - High Performance Fitness",
      "shortName": "TRENS",
      "description": "Entrena como un profesional. Registra tus entrenamientos, mide tu progreso y alcanza tus metas.",
      "lang": "es",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a TRENS acceder a tu cámara para grabar entrenamientos.",
          "microphonePermission": "Permitir a TRENS acceder al micrófono para grabar audio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir a TRENS acceder a tus fotos para seleccionar videos.",
          "savePhotosPermission": "Permitir a TRENS guardar fotos en tu galería.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a TRENS acceder a tu galería para seleccionar fotos y videos."
        }
      ],
      "expo-video",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#DC2626",
          "defaultChannel": "trens-default",
          "sounds": []
        }
      ]
    ],
    "scheme": "trensdev",
    "sdkVersion": "54.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "27fc2ccb-6af3-47ae-902f-94561e739752"
      },
      "supabaseUrl": "https://cnrcrhlrteeqsyhlxhbb.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNucmNyaGxydGVlcXN5aGx4aGJiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjYxODIyODYsImV4cCI6MjA4MTc1ODI4Nn0.9C2orxQ6xSBIt2Y7ua37rvlvPZBxNNIv0eZoYVRM5tE",
      "instagramAppId": "917846514493235",
