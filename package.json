{
  "name": "trens",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "bash scripts/build-web.sh",
    "web:export": "expo export --platform web && bash scripts/inject-pwa-meta.sh",
    "web:preview": "npx serve dist",
    "web:deploy": "npm run web:export && npx wrangler pages deploy dist --project-name=trens-app --branch=main --commit-dirty=true",
    "deploy:fast": "expo export --platform web --clear && bash scripts/inject-pwa-meta.sh && npx wrangler pages deploy dist --branch main",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf node_modules .expo dist",
    "reset": "npm run clean && npm install",
    "prepare": "husky",
    "postinstall": "patch-package && node scripts/fix-css-interop.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "base64-arraybuffer": "^1.0.2",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "expo": "^54.0.32",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "^19.0.21",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.22",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "^3.0.15",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "latest",
    "nativewind": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-spotify-remote": "^0.3.10",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.2",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "babel-preset-expo": "~54.0.9",
    "dotenv": "^17.2.3",
    "eslint-config-expo": "^10.0.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.1.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-spotify-remote",
          "react-native-events"
        ]
      }
    }
  }
}
